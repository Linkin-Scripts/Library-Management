<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared Input Label Style -->
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#8A7B6A"/>
        <Setter Property="LetterSpacing" Value="2"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- Shared Text Field Style -->
    <Style Selector="TextBox.field">
        <Setter Property="Background" Value="#FAF7F2"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="BorderBrush" Value="#D9CEBF"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="MinWidth" Value="320"/>

        <Style Selector="^:focus">
            <Setter Property="BorderBrush" Value="#8B5E3C"/>
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="Foreground" Value="#ffffff"/>
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="BorderBrush" Value="#B08060"/>
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="Foreground" Value="#F5EDD8"/>
        </Style>
    </Style>

    <!-- Shared Primary Button Style -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="#2C1F14"/>
        <Setter Property="Foreground" Value="#F5EDD8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="0,14"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Style Selector="^:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4A3020"/>
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A0F08"/>
        </Style>
    </Style>

</Styles>
